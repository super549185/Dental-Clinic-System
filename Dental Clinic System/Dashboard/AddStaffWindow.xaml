<Window x:Class="Dental_Clinic_System.Dashboard.AddStaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Staff" Height="620" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#006B6B" CornerRadius="10,10,0,0" Padding="25,20">
                <Grid>
                    <TextBlock Text="Add Staff Member" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" Cursor="Hand" Width="28" Height="28" Click="Cancel_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="25,20,25,10">
                    <!-- Image Picker -->
                    <TextBlock Text="PROFILE IMAGE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                    <Grid Height="100" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="100" Height="100" CornerRadius="50" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1">
                            <Image x:Name="PreviewImage" Stretch="UniformToFill" ClipToBounds="True"/>
                        </Border>
                        <Button Grid.Column="1" Content="Choose Image" Height="35" Background="#F3F4F6" Foreground="#374151" BorderThickness="0" FontSize="13" FontWeight="Medium" Cursor="Hand" Margin="15,0,0,0" Click="ChooseImage_Click"/>
                    </Grid>

                    <TextBlock Text="FULL NAME" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameBox" Height="38" Padding="10,0,10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center"/>

                    <Border Height="12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ROLE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                            <ComboBox x:Name="RoleBox" Height="38" Padding="10,0,10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center" SelectedIndex="0">
                                <ComboBoxItem Content="Dentist"/>
                                <ComboBoxItem Content="Hygienist"/>
                                <ComboBoxItem Content="Assistant"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                            <ComboBox x:Name="StatusBox" Height="38" Padding="10,0,10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center" SelectedIndex="0">
                                <ComboBoxItem Content="On Duty"/>
                                <ComboBoxItem Content="Off Duty"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Border Height="12"/>
                    <TextBlock Text="SPECIALIZATION" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                    <TextBox x:Name="SpecBox" Height="38" Padding="10,0,10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center"/>

                    <Border Height="12"/>
                    <TextBlock Text="SCHEDULE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Days" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                            <ComboBox x:Name="DaysBox" Height="38" Padding="10,0,10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="12" VerticalContentAlignment="Center" SelectedIndex="0">
                                <ComboBoxItem Content="Mon-Fri"/>
                                <ComboBoxItem Content="Mon-Sat"/>
                                <ComboBoxItem Content="Tue-Sat"/>
                                <ComboBoxItem Content="Mon-Sun"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Start Time" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                            <ComboBox x:Name="StartTimeBox" Height="38" Padding="10,0,10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="12" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="End Time" FontSize="10" Foreground="#9CA3AF" Margin="0,0,0,3"/>
                            <ComboBox x:Name="EndTimeBox" Height="38" Padding="10,0,10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="12" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="12"/>
                    <TextBlock Text="SERVICES OFFERED (Select Multiple)" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                    <ListBox x:Name="ServicesListBox" Height="100" Padding="5" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" SelectionMode="Multiple"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="25,0,25,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="40" Background="#F3F4F6" Foreground="#374151" BorderThickness="0" FontSize="14" FontWeight="Medium" Cursor="Hand" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="Save Staff" Height="40" Background="#006B6B" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>