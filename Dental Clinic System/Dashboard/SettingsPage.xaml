<Page x:Class="Dental_Clinic_System.Dashboard.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F9FAFB">

    <Grid Margin="30,25,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="Settings" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="Manage your clinic system preferences" FontSize="13" Foreground="#9CA3AF" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- CONTENT: sidebar nav + panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT NAV -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="8">
                <StackPanel>
                    <TextBlock Text="GENERAL" FontSize="10" FontWeight="SemiBold" Foreground="#9CA3AF"
                               Margin="10,10,10,6"/>
                    <Border x:Name="NavClinic"    CornerRadius="6" Padding="12,9" Cursor="Hand" Margin="0,0,0,2" MouseLeftButtonUp="Nav_Click" Tag="Clinic">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏥" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clinic Information" FontSize="13" FontWeight="Medium" Foreground="#374151" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavAccount"   CornerRadius="6" Padding="12,9" Cursor="Hand" Margin="0,0,0,2" MouseLeftButtonUp="Nav_Click" Tag="Account">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Account &amp; Security" FontSize="13" FontWeight="Medium" Foreground="#374151" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SYSTEM" FontSize="10" FontWeight="SemiBold" Foreground="#9CA3AF"
                               Margin="10,14,10,6"/>
                    <Border x:Name="NavAppointments" CornerRadius="6" Padding="12,9" Cursor="Hand" Margin="0,0,0,2" MouseLeftButtonUp="Nav_Click" Tag="Appointments">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Appointments" FontSize="13" FontWeight="Medium" Foreground="#374151" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- ✅ NEW: Archive Patients Navigation -->
                    <Border x:Name="NavArchive" CornerRadius="6" Padding="12,9" Cursor="Hand" Margin="0,0,0,2" MouseLeftButtonUp="Nav_Click" Tag="Archive">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Archived Patients" FontSize="13" FontWeight="Medium" Foreground="#374151" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavNotifications" CornerRadius="6" Padding="12,9" Cursor="Hand" Margin="0,0,0,2" MouseLeftButtonUp="Nav_Click" Tag="Notifications">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Notifications" FontSize="13" FontWeight="Medium" Foreground="#374151" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavDatabase"  CornerRadius="6" Padding="12,9" Cursor="Hand" Margin="0,0,0,2" MouseLeftButtonUp="Nav_Click" Tag="Database">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Database &amp; Backup" FontSize="13" FontWeight="Medium" Foreground="#374151" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="HELP" FontSize="10" FontWeight="SemiBold" Foreground="#9CA3AF"
                               Margin="10,14,10,6"/>
                    <Border x:Name="NavGuide"     CornerRadius="6" Padding="12,9" Cursor="Hand" Margin="0,0,0,2" MouseLeftButtonUp="Nav_Click" Tag="Guide">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="How-To Guide" FontSize="13" FontWeight="Medium" Foreground="#374151" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NavAbout"     CornerRadius="6" Padding="12,9" Cursor="Hand" Margin="0,0,0,2" MouseLeftButtonUp="Nav_Click" Tag="About">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="About System" FontSize="13" FontWeight="Medium" Foreground="#374151" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- RIGHT PANEL (content swapped in code-behind) -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsContent"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>