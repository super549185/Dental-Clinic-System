<Window x:Class="Dental_Clinic_System.ResetPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password" Height="520" Width="440"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border Background="Transparent" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <!-- Main Card -->
        <Border Background="#FFFFFF" CornerRadius="16" Margin="10"
                BorderThickness="1" BorderBrush="#E0E0E0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4"
                                  Opacity="0.15" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="*"/>
                    <!-- Content -->
                    <RowDefinition Height="Auto"/>
                    <!-- Step Indicator -->
                </Grid.RowDefinitions>

                <!-- ========== Header Bar ========== -->
                <Grid Grid.Row="0" Margin="24,20,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Back Button (hidden on step 1 & 4) -->
                    <Button x:Name="BtnBack" Grid.Column="0"
                            Click="BtnBack_Click"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            Width="36" Height="36">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="18">
                                    <Path Data="M14,8 L6,8 M6,8 L10,4 M6,8 L10,12"
                                          Stroke="#555555" StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Title -->
                    <TextBlock x:Name="TxtTitle" Grid.Column="1"
                               Text="Reset Password"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="#1A1A2E"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontFamily="Segoe UI"/>

                    <!-- Close Button -->
                    <Button x:Name="BtnClose" Grid.Column="2"
                            Click="BtnClose_Click"
                            Cursor="Hand"
                            Width="36" Height="36">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#F5F5F5" CornerRadius="18">
                                    <Path Data="M12,12 L24,24 M24,12 L12,24"
                                          Stroke="#888888" StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ========== Step Content Area ========== -->
                <!-- FIXED: One ScrollViewer wrapping ALL steps prevents cutting on any step -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="24,16,24,16">
                    <Grid>
                        <!-- Step 1: Reset Password (Email) -->
                        <StackPanel x:Name="Step1Content" Visibility="Visible">

                            <!-- Email Icon -->
                            <Border Width="80" Height="80" CornerRadius="40"
                                    Background="#EBF3FE" Margin="0,8,0,0"
                                    HorizontalAlignment="Center">
                                <Path Data="M20,30 L40,42 L60,30 L60,52 C60,54.2 58.2,56 56,56 L24,56 C21.8,56 20,54.2 20,52 Z M20,30 L20,28 C20,25.8 21.8,24 24,24 L56,24 C58.2,24 60,25.8 60,28 L60,30 L40,42 Z"
                                      Fill="#006B6B" Stretch="Uniform"
                                      Width="36" Height="36"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <!-- Description -->
                            <TextBlock Text="Enter your email address and we'll send you a verification code to reset your password."
                                       FontSize="14" Foreground="#6B7280"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       LineHeight="22"
                                       Margin="8,20,8,0"
                                       FontFamily="Segoe UI"/>

                            <!-- Email Input -->
                            <TextBlock Text="Email Address" FontSize="13"
                                       Foreground="#374151" FontWeight="Medium"
                                       Margin="0,24,0,6" FontFamily="Segoe UI"/>
                            <Border Background="#F9FAFB" CornerRadius="10"
                                    BorderThickness="1.5" BorderBrush="#D1D5DB"
                                    x:Name="EmailBorder">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M8,10 C8,7.79 9.79,6 12,6 C14.21,6 16,7.79 16,10 C16,12.21 14.21,14 12,14 C9.79,14 8,12.21 8,10 Z M6,26 C6,22.686 8.686,20 12,20 C15.314,20 18,22.686 18,26"
                                          Stroke="#9CA3AF" StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Stretch="Uniform"
                                          Width="18" Height="18"
                                          Margin="14,0,0,0"
                                          VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtEmail" Grid.Column="1"
                                             FontSize="14" Foreground="#1F2937"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Margin="10,0,14,0"
                                             Padding="0,14,0,14"
                                             VerticalAlignment="Center"
                                             FontFamily="Segoe UI"
                                             CaretBrush="#006B6B"/>
                                </Grid>
                            </Border>

                            <!-- Send Verification Code Button -->
                            <Button x:Name="BtnSendCode" Click="BtnSendCode_Click"
                                    Margin="0,28,0,0" Cursor="Hand"
                                    Height="50">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="SendBtnBg" Background="#006B6B"
                                                CornerRadius="12" Cursor="Hand">
                                            <Border.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </Style>
                                            </Border.Resources>
                                            <TextBlock Text="Send Verification Code"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       FontFamily="Segoe UI"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SendBtnBg" Property="Background" Value="#2563EB"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="SendBtnBg" Property="Background" Value="#1D4ED8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Step 2: Verify Code -->
                        <StackPanel x:Name="Step2Content" Visibility="Collapsed">

                            <!-- Lock Icon -->
                            <Border Width="80" Height="80" CornerRadius="40"
                                    Background="#F3EEFF" Margin="0,8,0,0"
                                    HorizontalAlignment="Center">
                                <Path Data="M30,38 L30,32 C30,27.58 33.58,24 38,24 C42.42,24 46,27.58 46,32 L46,38 M28,38 L48,38 C49.1,38 50,38.9 50,40 L50,54 C50,55.1 49.1,56 48,56 L28,56 C26.9,56 26,55.1 26,54 L26,40 C26,38.9 26.9,38 28,38 Z"
                                      Stroke="#7C3AED" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Width="34" Height="34"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <!-- Description -->
                            <TextBlock FontSize="14" Foreground="#6B7280"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       LineHeight="22" Margin="8,20,8,0"
                                       FontFamily="Segoe UI">
                                <Run Text="A 6-digit verification code has been sent to"/>
                                <LineBreak/>
                                <Run x:Name="RunEmail2"
                                     FontWeight="SemiBold" Foreground="#374151"/>
                            </TextBlock>

                            <!-- Verification Code Input -->
                            <TextBlock Text="Verification Code" FontSize="13"
                                       Foreground="#374151" FontWeight="Medium"
                                       Margin="0,24,0,6" FontFamily="Segoe UI"/>
                            <Border Background="#F9FAFB" CornerRadius="10"
                                    BorderThickness="1.5" BorderBrush="#D1D5DB"
                                    x:Name="CodeBorder">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M22,28 L38,28 C39.1,28 40,28.9 40,30 L40,46 C40,47.1 39.1,48 38,48 L22,48 C20.9,48 20,47.1 20,46 L20,30 C20,28.9 20.9,28 22,28 Z M26,28 L26,24 C26,21.79 27.79,20 30,20 C32.21,20 34,21.79 34,24 L34,28"
                                          Stroke="#9CA3AF" StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Stretch="Uniform"
                                          Width="18" Height="18"
                                          Margin="14,0,0,0"
                                          VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtCode" Grid.Column="1"                                         
                                             FontSize="14" Foreground="#1F2937"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Margin="10,0,14,0"
                                             Padding="0,14,0,14"
                                             VerticalAlignment="Center"
                                             FontFamily="Segoe UI"
                                             MaxLength="6"
                                             CaretBrush="#7C3AED"/>
                                </Grid>
                            </Border>

                            <!-- Verify Code Button -->
                            <Button x:Name="BtnVerifyCode" Click="BtnVerifyCode_Click"
                                    Margin="0,28,0,0" Cursor="Hand"
                                    Height="50">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="VerifyBtnBg" Background="#7C3AED"
                                                CornerRadius="12" Cursor="Hand">
                                            <TextBlock Text="Verify Code"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe UI"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="VerifyBtnBg" Property="Background" Value="#6D28D9"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="VerifyBtnBg" Property="Background" Value="#5B21B6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Resend Link -->
                            <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0"
                                       FontSize="13" FontFamily="Segoe UI">
                                <Run Text="Didn't receive the code? " Foreground="#9CA3AF"/>
                                <Hyperlink x:Name="ResendLink" Click="ResendLink_Click"
                                           Foreground="#7C3AED" FontWeight="SemiBold"
                                           TextDecorations="None">Resend</Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <!-- Step 3: New Password -->
                        <StackPanel x:Name="Step3Content" Visibility="Collapsed">

                            <!-- Shield Icon -->
                            <Border Width="80" Height="80" CornerRadius="40"
                                    Background="#ECFDF5" Margin="0,8,0,0"
                                    HorizontalAlignment="Center" >
                                <Path Data="M30,20 L40,16 L50,20 L50,36 C50,46 40,52 40,52 C40,52 30,46 30,36 Z M36,36 L39,39 L46,32"
                                      Stroke="#10B981" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Width="34" Height="34"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <!-- Description -->
                            <TextBlock Text="Create a strong password for your account"
                                       FontSize="14" Foreground="#6B7280"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       LineHeight="22" Margin="6,20,6,0"
                                       FontFamily="Segoe UI"/>

                            <!-- New Password Input -->
                            <TextBlock Text="New Password" FontSize="13"
                                       Foreground="#374151" FontWeight="Medium"
                                       Margin="0,24,0,6" FontFamily="Segoe UI"/>
                            <Border Background="#F9FAFB" CornerRadius="10"
                                    BorderThickness="1.5" BorderBrush="#D1D5DB"
                                    x:Name="NewPwdBorder">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M18,32 C18,27.58 21.58,24 26,24 C30.42,24 34,27.58 34,32 L34,38 M16,38 L36,38 C37.1,38 38,38.9 38,40 L38,54 C38,55.1 37.1,56 36,56 L16,56 C14.9,56 14,55.1 14,54 L14,40 C14,38.9 14.9,38 16,38 Z"
                                          Stroke="#9CA3AF" StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Stretch="Uniform"
                                          Width="18" Height="18"
                                          Margin="14,0,0,0"
                                          VerticalAlignment="Center"/>
                                    <PasswordBox x:Name="TxtNewPassword" Grid.Column="1"
                                                 FontSize="14" Foreground="#1F2937"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Margin="10,0,0,0"
                                                 Padding="0,14,0,14"
                                                 VerticalAlignment="Center"
                                                 FontFamily="Segoe UI"
                                                 CaretBrush="#10B981"/>
                                    <Button x:Name="BtnToggleNewPwd" Grid.Column="2"
                                            Click="BtnToggleNewPwd_Click"
                                            Width="40" Height="40"
                                            Cursor="Hand"
                                            Tag="hidden">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Path x:Name="EyeIcon1"
                                                          Data="M12,22 C12,22 18,14 26,14 C34,14 40,22 40,22 C40,22 34,30 26,30 C18,30 12,22 12,22 Z M26,18 C23.79,18 22,19.79 22,22 C22,24.21 23.79,26 26,26 C28.21,26 30,24.21 30,22 C30,19.79 28.21,18 26,18 Z"
                                                          Stroke="#9CA3AF" StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Fill="Transparent"
                                                          Stretch="Uniform"
                                                          Width="22" Height="22"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Confirm Password Input -->
                            <TextBlock Text="Confirm Password" FontSize="13"
                                       Foreground="#374151" FontWeight="Medium"
                                       Margin="0,16,0,6" FontFamily="Segoe UI"/>
                            <Border Background="#F9FAFB" CornerRadius="10"
                                    BorderThickness="1.5" BorderBrush="#D1D5DB"
                                    x:Name="ConfirmPwdBorder">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M18,32 C18,27.58 21.58,24 26,24 C30.42,24 34,27.58 34,32 L34,38 M16,38 L36,38 C37.1,38 38,38.9 38,40 L38,54 C38,55.1 37.1,56 36,56 L16,56 C14.9,56 14,55.1 14,54 L14,40 C14,38.9 14.9,38 16,38 Z"
                                          Stroke="#9CA3AF" StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Stretch="Uniform"
                                          Width="18" Height="18"
                                          Margin="14,0,0,0"
                                          VerticalAlignment="Center"/>
                                    <PasswordBox x:Name="TxtConfirmPassword" Grid.Column="1"
                                                 FontSize="14" Foreground="#1F2937"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Margin="10,0,0,0"
                                                 Padding="0,14,0,14"
                                                 VerticalAlignment="Center"
                                                 FontFamily="Segoe UI"
                                                 CaretBrush="#10B981"/>
                                    <Button x:Name="BtnToggleConfirmPwd" Grid.Column="2"
                                            Click="BtnToggleConfirmPwd_Click"
                                            Width="40" Height="40"
                                            Cursor="Hand"
                                            Tag="hidden">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Path x:Name="EyeIcon2"
                                                          Data="M12,22 C12,22 18,14 26,14 C34,14 40,22 40,22 C40,22 34,30 26,30 C18,30 12,22 12,22 Z M26,18 C23.79,18 22,19.79 22,22 C22,24.21 23.79,26 26,26 C28.21,26 30,24.21 30,22 C30,19.79 28.21,18 26,18 Z"
                                                          Stroke="#9CA3AF" StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Fill="Transparent"
                                                          Stretch="Uniform"
                                                          Width="22" Height="22"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Reset Password Button -->
                            <Button x:Name="BtnResetPassword" Click="BtnResetPassword_Click"
                                    Margin="0,28,0,0" Cursor="Hand"
                                    Height="50">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ResetBtnBg" Background="#10B981"
                                                CornerRadius="12" Cursor="Hand">
                                            <TextBlock Text="Reset Password"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe UI"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ResetBtnBg" Property="Background" Value="#059669"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ResetBtnBg" Property="Background" Value="#047857"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Step 4: Success -->
                        <StackPanel x:Name="Step4Content" Visibility="Collapsed">

                            <!-- Success Checkmark Icon -->
                            <Border Width="90" Height="90" CornerRadius="45"
                                    Background="#ECFDF5" Margin="0,24,0,0"
                                    HorizontalAlignment="Center">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="90" Height="90" Fill="#10B981" Opacity="0.12"/>
                                    <Path Data="M24,40 L34,50 L52,30"
                                          Stroke="#10B981" StrokeThickness="4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Stretch="Uniform"
                                          Width="38" Height="38"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Success Title -->
                            <TextBlock Text="Password Reset Successful!"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#1A1A2E"
                                       HorizontalAlignment="Center"
                                       Margin="0,28,0,0"
                                       FontFamily="Segoe UI"/>

                            <!-- Success Description -->
                            <TextBlock Text="Your password has been updated. You can now login with your new password."
                                       FontSize="14" Foreground="#6B7280"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       LineHeight="22" Margin="16,12,16,0"
                                       FontFamily="Segoe UI"/>

                            <!-- Done Button -->
                            <Button x:Name="BtnDone" Click="BtnDone_Click"
                                    Margin="0,36,0,0" Cursor="Hand"
                                    Height="50">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="DoneBtnBg" Background="#10B981"
                                                CornerRadius="12" Cursor="Hand">
                                            <TextBlock Text="Back to Login"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe UI"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DoneBtnBg" Property="Background" Value="#059669"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="DoneBtnBg" Property="Background" Value="#047857"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ========== Step Indicator (Dots) ========== -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,28">
                    <Ellipse x:Name="Dot1" Width="10" Height="10" Margin="5,0" Fill="#3B82F6"/>
                    <Ellipse x:Name="Dot2" Width="10" Height="10" Margin="5,0" Fill="#D1D5DB"/>
                    <Ellipse x:Name="Dot3" Width="10" Height="10" Margin="5,0" Fill="#D1D5DB"/>
                    <Ellipse x:Name="Dot4" Width="10" Height="10" Margin="5,0" Fill="#D1D5DB"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>