<Window x:Class="Dental_Clinic_System.Dashboard.PatientTypeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Patient Type" Height="280" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#006B6B" CornerRadius="10,10,0,0" Padding="25,20">
                <TextBlock Text="Add Appointment" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Row="1" Margin="30,30" VerticalAlignment="Center">
                <TextBlock Text="Is this an existing patient or a new patient?" FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,25" TextWrapping="Wrap" TextAlignment="Center"/>

                <Button Content="Existing Patient" Height="45" Background="#006B6B" Foreground="White" BorderThickness="0" 
                        FontSize="15" FontWeight="SemiBold" Cursor="Hand" Click="OldPatient_Click" Margin="0,0,0,15"/>

                <Button Content="New Patient" Height="45" Background="#F3F4F6" Foreground="#374151" BorderThickness="1" 
                        BorderBrush="#D1D5DB" FontSize="15" FontWeight="SemiBold" Cursor="Hand" Click="NewPatient_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>