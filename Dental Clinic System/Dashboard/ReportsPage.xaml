<Page x:Class="Dental_Clinic_System.Dashboard.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Reports">

    <ScrollViewer Background="#F8FAFC" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,25,30,30">

            <!-- ========== Header ========== -->
            <TextBlock Text="Reports" FontSize="24" FontWeight="Bold" Foreground="#1E293B" FontFamily="Segoe UI"/>
            <TextBlock Text="View analytics and generate reports" FontSize="14" Foreground="#64748B" Margin="0,4,0,24" FontFamily="Segoe UI"/>

            <!-- ========== Top 4 Summary Cards ========== -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <!-- Card 1 -->
                <Border Background="#EFF6FF" CornerRadius="12" Margin="0,0,12,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Daily Appointments" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI"/>
                        <TextBlock Text="24" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0,6,0,0" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>
                <!-- Card 2 -->
                <Border Background="#F0FDF4" CornerRadius="12" Margin="0,0,12,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Monthly Revenue" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI"/>
                        <TextBlock Text="$45,850" FontSize="24" FontWeight="Bold" Foreground="#16A34A" Margin="0,6,0,0" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>
                <!-- Card 3 -->
                <Border Background="#F5F3FF" CornerRadius="12" Margin="0,0,12,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Popular Service" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI"/>
                        <TextBlock Text="Cleaning" FontSize="24" FontWeight="Bold" Foreground="#7C3AED" Margin="0,6,0,0" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>
                <!-- Card 4 -->
                <Border Background="#FFF7ED" CornerRadius="12" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Returning Patients" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI"/>
                        <TextBlock Text="86%" FontSize="24" FontWeight="Bold" Foreground="#EA580C" Margin="0,6,0,0" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ========== Middle Row: Bar & Line Charts ========== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Bar Chart: Daily Appointments -->
                <Border Background="#FFFFFF" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Daily Appointments (This Week)" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" FontFamily="Segoe UI" Margin="0,0,0,16"/>

                        <Grid Height="150">
                            <!-- Grid Lines -->
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" VerticalAlignment="Top" Margin="0,0,0,0"/>
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" VerticalAlignment="Center"/>
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                            <!-- Bars Container -->
                            <UniformGrid Columns="7" VerticalAlignment="Bottom" Margin="0,0,0,-20">
                                <!-- Mon -->
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="24" Background="#3B82F6" CornerRadius="4,4,0,0" Height="60"/>
                                    <TextBlock Text="Mon" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <!-- Tue -->
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="24" Background="#3B82F6" CornerRadius="4,4,0,0" Height="90"/>
                                    <TextBlock Text="Tue" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <!-- Wed -->
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="24" Background="#3B82F6" CornerRadius="4,4,0,0" Height="120"/>
                                    <TextBlock Text="Wed" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <!-- Thu -->
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="24" Background="#3B82F6" CornerRadius="4,4,0,0" Height="80"/>
                                    <TextBlock Text="Thu" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <!-- Fri -->
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="24" Background="#3B82F6" CornerRadius="4,4,0,0" Height="140"/>
                                    <TextBlock Text="Fri" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <!-- Sat -->
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="24" Background="#93C5FD" CornerRadius="4,4,0,0" Height="50"/>
                                    <TextBlock Text="Sat" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <!-- Sun -->
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="24" Background="#93C5FD" CornerRadius="4,4,0,0" Height="20"/>
                                    <TextBlock Text="Sun" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Line Chart: Monthly Income -->
                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Monthly Income" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" FontFamily="Segoe UI" Margin="0,0,0,16"/>

                        <Canvas Height="150" Margin="0,0,0,-20">
                            <!-- Grid lines -->
                            <Line X1="0" Y1="0" X2="400" Y2="0" Stroke="#F1F5F9" StrokeThickness="1"/>
                            <Line X1="0" Y1="75" X2="400" Y2="75" Stroke="#F1F5F9" StrokeThickness="1"/>
                            <Line X1="0" Y1="149" X2="400" Y2="149" Stroke="#E2E8F0" StrokeThickness="1"/>

                            <!-- Gradient Fill under line -->
                            <Path Data="M 0,120 C 50,110 70,80 130,90 C 190,100 200,50 260,40 C 320,30 340,60 400,20 L 400,150 L 0,150 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#10B981" Offset="0.0"/>
                                        <GradientStop Color="#FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>

                            <!-- Line -->
                            <Path Data="M 0,120 C 50,110 70,80 130,90 C 190,100 200,50 260,40 C 320,30 340,60 400,20" 
                                  Stroke="#10B981" StrokeThickness="3" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                            <!-- Dots on line -->
                            <Ellipse Canvas.Left="126" Canvas.Top="86" Width="8" Height="8" Fill="#FFFFFF" Stroke="#10B981" StrokeThickness="2"/>
                            <Ellipse Canvas.Left="256" Canvas.Top="36" Width="8" Height="8" Fill="#FFFFFF" Stroke="#10B981" StrokeThickness="2"/>
                            <Ellipse Canvas.Left="396" Canvas.Top="16" Width="8" Height="8" Fill="#FFFFFF" Stroke="#10B981" StrokeThickness="2"/>

                            <!-- X Axis Labels -->
                            <TextBlock Canvas.Left="0" Canvas.Top="160" Text="Jan" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Canvas.Left="120" Canvas.Top="160" Text="Mar" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Canvas.Left="240" Canvas.Top="160" Text="May" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Canvas.Left="370" Canvas.Top="160" Text="Jun" FontSize="10" Foreground="#94A3B8"/>
                        </Canvas>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========== Bottom Row: Pie, Table, Patient Ratio ========== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Pie Chart: Most Requested Services -->
                <Border Background="#FFFFFF" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Most Requested Services" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" FontFamily="Segoe UI" Margin="0,0,0,16"/>

                        <!-- Simulated Pie/Donut Chart using Ellipses and Clip -->
                        <Grid Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Ellipse Fill="#3B82F6"/>
                            <!-- Base 100% Blue (Cleaning 35%) -->
                            <Ellipse Fill="#10B981" Margin="0,0,0,0">
                                <!-- Green 65% (Exams 25%) -->
                                <Ellipse.Clip>
                                    <RectangleGeometry Rect="0,0,120,84"/>
                                    <!-- Approx 65% fill -->
                                </Ellipse.Clip>
                            </Ellipse>
                            <Ellipse Fill="#F59E0B" Margin="0,0,0,0">
                                <!-- Orange 40% (Fillings) -->
                                <Ellipse.Clip>
                                    <RectangleGeometry Rect="0,0,120,48"/>
                                    <!-- Approx 40% fill -->
                                </Ellipse.Clip>
                            </Ellipse>
                            <!-- Inner circle for Donut effect -->
                            <Ellipse Fill="#FFFFFF" Margin="30,30,30,30"/>
                        </Grid>

                        <!-- Legend -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="10" Height="10" Fill="#3B82F6" Margin="0,0,6,0"/>
                            <TextBlock Text="Cleaning (35%)" FontSize="11" Foreground="#475569" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,6,0"/>
                            <TextBlock Text="Exams (25%)" FontSize="11" Foreground="#475569" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="10" Height="10" Fill="#F59E0B" Margin="0,0,6,0"/>
                            <TextBlock Text="Fillings (15%)" FontSize="11" Foreground="#475569" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0"/>
                            <TextBlock Text="Root Canals (12%)" FontSize="11" Foreground="#475569" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Dentist Performance Table -->
                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <DataGrid x:Name="DentistDataGrid" 
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#F8FAFC"
                              CanUserAddRows="False" CanUserResizeColumns="False"
                              CanUserResizeRows="False" IsReadOnly="True"
                              FontFamily="Segoe UI">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="6,0,6,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,8"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#334155"/>
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#F1F5F9"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DENTIST" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="APPTS" Binding="{Binding Appointments}" Width="60"/>
                            <DataGridTextColumn Header="AVG RATE" Binding="{Binding AvgRate}" Width="70"/>
                            <DataGridTextColumn Header="REVENUE" Binding="{Binding Revenue}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- New vs Returning Patients -->
                <Border Grid.Column="4" Background="#FFFFFF" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Patients Ratio" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" FontFamily="Segoe UI" Margin="0,0,0,20"/>

                        <!-- New Patients -->
                        <TextBlock Text="New Patients" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI"/>
                        <Grid Height="16" Margin="0,4,0,4">
                            <Border Background="#F1F5F9" CornerRadius="8"/>
                            <Border Background="#3B82F6" CornerRadius="8" Width="56"/>
                            <!-- 14% approx -->
                        </Grid>
                        <TextBlock Text="145 (14%)" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,16" FontFamily="Segoe UI"/>

                        <!-- Returning Patients -->
                        <TextBlock Text="Returning Patients" FontSize="12" Foreground="#64748B" FontFamily="Segoe UI"/>
                        <Grid Height="16" Margin="0,4,0,4">
                            <Border Background="#F1F5F9" CornerRadius="8"/>
                            <Border Background="#10B981" CornerRadius="8" Width="344"/>
                            <!-- 86% approx -->
                        </Grid>
                        <TextBlock Text="892 (86%)" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>