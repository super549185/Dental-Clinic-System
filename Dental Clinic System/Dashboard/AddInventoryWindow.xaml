<Window x:Class="Dental_Clinic_System.Dashboard.AddInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Item" Height="480" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#006B6B" CornerRadius="10,10,0,0" Padding="25,20">
                <Grid>
                    <TextBlock Text="Add New Item" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" Cursor="Hand" Width="28" Height="28" Click="Cancel_Click"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="25,20,25,10">
                <TextBlock Text="ITEM NAME" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                <TextBox x:Name="NameBox" Height="38" Padding="10,0,10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center"/>

                <Border Height="12"/>
                <TextBlock Text="CATEGORY" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                <ComboBox x:Name="CategoryBox" Height="38" Padding="10,0,10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center" SelectedIndex="0">
                    <ComboBoxItem Content="Supplies"/>
                    <ComboBoxItem Content="Medication"/>
                    <ComboBoxItem Content="Equipment"/>
                </ComboBox>

                <Border Height="12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="QUANTITY" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                        <TextBox x:Name="QtyBox" Height="38" Padding="10,0,10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center" Text="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="REORDER LEVEL" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                        <TextBox x:Name="ReorderBox" Height="38" Padding="10,0,10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center" Text="0"/>
                    </StackPanel>
                </Grid>

                <Border Height="12"/>
                <TextBlock Text="EXPIRY DATE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                <DatePicker x:Name="ExpiryBox" Height="38" Padding="10,0,10,0" Background="#F9FAFB" BorderBrush="#E5E7EB" VerticalContentAlignment="Center" FontSize="13"/>
            </StackPanel>
            <Grid Grid.Row="2" Margin="25,0,25,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="40" Background="#F3F4F6" Foreground="#374151" BorderThickness="0" FontSize="14" FontWeight="Medium" Cursor="Hand" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="Save Item" Height="40" Background="#006B6B" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>