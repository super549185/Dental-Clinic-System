<!-- BillingPage.xaml -->
<Page
    x:Class="Dental_Clinic_System.Dashboard.BillingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F5F6F8">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel>
            <TextBlock Text="Billing"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>

            <TextBlock Text="Manage invoices and payments"
                       FontSize="15"
                       Foreground="#64748B"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Summary Cards -->
        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,20,0,0">

            <!-- Card 1 -->
            <Border Background="White"
                    CornerRadius="12"
                    Margin="0,0,15,0"
                    Padding="20"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Total Revenue"
                               FontSize="14"
                               Foreground="#64748B"/>
                    <TextBlock Text="$45,850"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#0F766E"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2 -->
            <Border Background="White"
                    CornerRadius="12"
                    Margin="0,0,15,0"
                    Padding="20"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Paid Invoices"
                               FontSize="14"
                               Foreground="#64748B"/>
                    <TextBlock Text="$38,200"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#16A34A"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3 -->
            <Border Background="White"
                    CornerRadius="12"
                    Margin="0,0,15,0"
                    Padding="20"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Unpaid Invoices"
                               FontSize="14"
                               Foreground="#64748B"/>
                    <TextBlock Text="$7,650"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#DC2626"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4 -->
            <Border Background="White"
                    CornerRadius="12"
                    Padding="20"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Total Invoices"
                               FontSize="14"
                               Foreground="#64748B"/>
                    <TextBlock Text="245"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#0F766E"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Invoice Table -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="12"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <StackPanel>

                <TextBlock Text="Recent Invoices"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Margin="25,20,0,20"/>

                <DataGrid AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          RowHeight="60"
                          FontSize="15">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="INVOICE NO."
                                            Binding="{Binding InvoiceNo}"
                                            Width="150"/>

                        <DataGridTextColumn Header="PATIENT"
                                            Binding="{Binding Patient}"
                                            Width="200"/>

                        <DataGridTextColumn Header="AMOUNT"
                                            Binding="{Binding Amount}"
                                            Width="120"/>

                        <DataGridTextColumn Header="STATUS"
                                            Binding="{Binding Status}"
                                            Width="140"/>

                        <DataGridTextColumn Header="DATE"
                                            Binding="{Binding Date}"
                                            Width="160"/>

                        <DataGridTextColumn Header="PAYMENT METHOD"
                                            Binding="{Binding PaymentMethod}"
                                            Width="200"/>

                        <!-- Button -->
                        <DataGridTemplateColumn Header="ACTIONS"
                                                Width="120">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Button Content="View"
                                            Width="80"
                                            Height="35"
                                            Background="#0F766E"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="ViewReceipt_Click"/>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>

        </Border>
    </Grid>
</Page>