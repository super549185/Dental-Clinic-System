<Page x:Class="Dental_Clinic_System.Dashboard.AppointmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F9FAFB">

    <Grid Margin="30,25,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Appointments" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Manage all clinic appointments" FontSize="13" Foreground="#9CA3AF" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="Add Appointment" Background="#10B981" Foreground="White" BorderThickness="0" Padding="15,10" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="AddAppointment_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- FILTER TABS -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="15,0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="TabAll" BorderBrush="#006B6B" BorderThickness="0,0,0,2" Margin="0,0,5,0" Padding="16,12" Cursor="Hand" MouseLeftButtonUp="Filter_Click" Tag="All">
                    <TextBlock Text="All Appointments" FontSize="14" FontWeight="SemiBold" Foreground="#006B6B"/>
                </Border>
                <Border x:Name="TabConfirmed" BorderThickness="0" Margin="0,0,5,0" Padding="16,12" Cursor="Hand" MouseLeftButtonUp="Filter_Click" Tag="Confirmed">
                    <TextBlock Text="Confirmed" FontSize="14" FontWeight="Medium" Foreground="#6B7280"/>
                </Border>
                <Border x:Name="TabCancelled" BorderThickness="0" Margin="0,0,5,0" Padding="16,12" Cursor="Hand" MouseLeftButtonUp="Filter_Click" Tag="Cancelled">
                    <TextBlock Text="Cancelled" FontSize="14" FontWeight="Medium" Foreground="#6B7280"/>
                </Border>
                <Border x:Name="TabToday" BorderThickness="0" Padding="16,12" Cursor="Hand" MouseLeftButtonUp="Filter_Click" Tag="Today">
                    <TextBlock Text="Today's Appointments" FontSize="14" FontWeight="Medium" Foreground="#6B7280"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- SEARCH BAR & RESULT COUNT -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="5" Height="40">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="12,0,10,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="13" VerticalContentAlignment="Center" Foreground="#111827" Text="Search patient..." GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Border>
            <TextBlock x:Name="ResultCount" Grid.Column="1" Text="" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </Grid>

        <!-- TABLE CONTAINER -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TABLE HEADER -->
                <Border Grid.Row="0" Background="#F9FAFB" Height="45" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                    <Grid Margin="15,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="APPOINTMENT ID" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="PATIENT NAME" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="DENTIST" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="SERVICE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="DATE &amp; TIME" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- DATA ROWS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AppointmentList"/>
                </ScrollViewer>

                <!-- EMPTY STATE -->
                <TextBlock x:Name="EmptyState" Text="No appointments found." FontSize="16" Foreground="#9CA3AF" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Page>