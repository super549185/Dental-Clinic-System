<Window x:Class="Dental_Clinic_System.Dashboard.PatientFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patient" Height="740" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True">

    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="#006B6B" CornerRadius="10,10,0,0" Padding="25,20">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="FormTitle" Text="New Patient" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Enter patient details" FontSize="12" Foreground="#A7F3D0" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Background="Transparent" Foreground="White" BorderThickness="0" 
                            FontSize="16" Cursor="Hand" Width="28" Height="28" Click="Cancel_Click"/>
                </Grid>
            </Border>

            <!-- FORM FIELDS -->
            <StackPanel Grid.Row="1" Margin="25,20,25,10">

                <TextBlock Text="FULL NAME" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                <TextBox x:Name="NameBox" Height="38" Padding="10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center"/>

                <Border Height="12"/>
                <TextBlock Text="CONTACT NUMBER" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                <TextBox x:Name="ContactBox" Height="38" Padding="10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center"/>

                <Border Height="12"/>
                <TextBlock Text="EMAIL ADDRESS" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                <TextBox x:Name="EmailBox" Height="38" Padding="10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center"/>

                <Border Height="12"/>
                <TextBlock Text="DATE OF BIRTH" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                <DatePicker x:Name="DobBox" Height="38" Padding="10,0" Background="#F9FAFB" BorderBrush="#E5E7EB" VerticalContentAlignment="Center" FontSize="13"/>

                <Border Height="12"/>
                <TextBlock Text="ADDRESS" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                <TextBox x:Name="AddressBox" Height="38" Padding="10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center"/>

                <Border Height="12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ALLERGIES" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                        <TextBox x:Name="AllergiesBox" Height="38" Padding="10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="BLOOD TYPE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                        <ComboBox x:Name="BloodBox" Height="38" Padding="10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="O+"/>
                            <ComboBoxItem Content="O-"/>
                            <ComboBoxItem Content="A+"/>
                            <ComboBoxItem Content="A-"/>
                            <ComboBoxItem Content="B+"/>
                            <ComboBoxItem Content="B-"/>
                            <ComboBoxItem Content="AB+"/>
                            <ComboBoxItem Content="AB-"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Border Height="12"/>
                <TextBlock Text="MEDICAL CONDITIONS" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                <TextBox x:Name="ConditionsBox" Height="38" Padding="10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center"/>

                <Border Height="12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="LAST VISIT" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                        <DatePicker x:Name="LastVisitBox" Height="38" Padding="10,0" Background="#F9FAFB" BorderBrush="#E5E7EB" VerticalContentAlignment="Center" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,0,5"/>
                        <ComboBox x:Name="StatusBox" Height="38" Padding="10,0" Background="#F9FAFB" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="13" VerticalContentAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="Active"/>
                            <ComboBoxItem Content="Inactive"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

            </StackPanel>

            <!-- BUTTONS -->
            <Grid Grid.Row="2" Margin="25,0,25,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="40" Background="#F3F4F6" Foreground="#374151" BorderThickness="0" FontSize="14" FontWeight="Medium" Cursor="Hand" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="Save Patient" Height="40" Background="#006B6B" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>