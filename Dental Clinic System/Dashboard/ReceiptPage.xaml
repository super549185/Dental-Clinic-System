<Page x:Class="Dental_Clinic_System.Dashboard.ReceiptPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F3F4F6">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Back & Download Buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="← Back to Billing" Background="White" Foreground="#374151" BorderBrush="#D1D5DB" 
                    BorderThickness="1" Padding="15,8" FontSize="13" Cursor="Hand" Click="Back_Click" Margin="0,0,10,0"/>
            <Button Content="⬇ Download Receipt" Background="#0F766E" Foreground="White" BorderThickness="0" 
                    Padding="15,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Click="Download_Click"/>
        </StackPanel>

        <!-- THE ACTUAL RECEIPT TO BE DOWNLOADED -->
        <!-- x:Name="ReceiptCard" is important so we can take a screenshot of this exact part -->
        <Border x:Name="ReceiptCard" Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                CornerRadius="8" MaxWidth="600" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="40">
            <StackPanel>

                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="DentaCare Clinic" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="123 Dental Street, City" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                        <TextBlock Text="Phone: (123) 456-7890" FontSize="12" Foreground="#6B7280"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="INVOICE" FontSize="20" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Top"/>
                </Grid>

                <Border Height="1" Background="#E5E7EB" Margin="0,0,0,20"/>

                <!-- Invoice Details Grid -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Invoice No:" FontSize="11" Foreground="#6B7280"/>
                        <TextBlock x:Name="TxtInvoiceNo" Text="-" FontSize="13" FontWeight="Medium" Foreground="#111827" Margin="0,0,0,10"/>
                        <TextBlock Text="Date:" FontSize="11" Foreground="#6B7280"/>
                        <TextBlock x:Name="TxtDate" Text="-" FontSize="13" FontWeight="Medium" Foreground="#111827"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Billed To:" FontSize="11" Foreground="#6B7280"/>
                        <TextBlock x:Name="TxtPatient" Text="-" FontSize="13" FontWeight="Medium" Foreground="#111827" Margin="0,0,0,10"/>
                        <TextBlock Text="Due Date:" FontSize="11" Foreground="#6B7280"/>
                        <TextBlock x:Name="TxtDueDate" Text="-" FontSize="13" FontWeight="Medium" Foreground="#111827"/>
                    </StackPanel>
                </Grid>

                <!-- Services Table Header -->
                <Border Background="#F9FAFB" Padding="10,8" CornerRadius="4,4,0,0" BorderBrush="#E5E7EB" BorderThickness="1,1,1,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SERVICE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="1" Text="QTY" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="AMOUNT" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Services List (Dynamic) -->
                <Border x:Name="ServicesContainer" BorderBrush="#E5E7EB" BorderThickness="1,0,1,1" Padding="10">
                    <StackPanel x:Name="ServicesList"/>
                </Border>

                <!-- Totals -->
                <Grid Margin="0,15,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Subtotal: " FontSize="12" Foreground="#6B7280" Width="70" TextAlignment="Right"/>
                            <TextBlock x:Name="TxtSubtotal" Text="₱0.00" FontSize="12" Foreground="#111827" FontWeight="Medium"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Tax: " FontSize="12" Foreground="#6B7280" Width="70" TextAlignment="Right"/>
                            <TextBlock Text="₱0.00" FontSize="12" Foreground="#111827"/>
                        </StackPanel>
                        <Border Height="1" Background="#E5E7EB" Margin="0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Total: " FontSize="14" Foreground="#111827" FontWeight="Bold" Width="70" TextAlignment="Right"/>
                            <TextBlock x:Name="TxtTotal" Text="₱0.00" FontSize="14" Foreground="#0F766E" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Footer Status -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Payment Method:" FontSize="11" Foreground="#6B7280"/>
                        <TextBlock x:Name="TxtMethod" Text="-" FontSize="13" FontWeight="Medium" Foreground="#111827"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#D1FAE5" CornerRadius="4" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatus" Text="PAID" FontSize="12" FontWeight="Bold" Foreground="#065F46"/>
                    </Border>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Page>