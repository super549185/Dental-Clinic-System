<Page x:Class="Dental_Clinic_System.Dashboard.ServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F9FAFB">

    <Grid Margin="30,25,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Services" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Manage dental services and procedures" FontSize="13" Foreground="#9CA3AF" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Add Service" Background="#10B981" Foreground="White" BorderThickness="0" Padding="15,10" FontSize="14" FontWeight="SemiBold" Cursor="Hand" Click="ToggleForm_Click" Tag="Add">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="White"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- ADD/EDIT FORM (Hidden by default) -->
        <Border x:Name="FormPanel" Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="25" Margin="0,0,0,20" Visibility="Collapsed">
            <TextBlock x:Name="FormTitle" Text="Add New Service" FontSize="16" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,15"/>
            <!-- We will build the form in code-behind to avoid XAML length limits and errors -->
        </Border>

        <!-- TABLE HEADER -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Height="45">
            <Grid Margin="25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="SERVICE NAME" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="CATEGORY" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="PRICE" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="DURATION" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- DATA ROWS -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ServiceList"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>